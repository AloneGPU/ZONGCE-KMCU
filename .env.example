# ==================== 服务器配置 ====================
PORT=3000
NODE_ENV=development
TRUST_PROXY=1
JSON_BODY_LIMIT=1mb

# ==================== 数据库配置 (MySQL) ====================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zongce
DB_USER=root
DB_PASSWORD=your_password_here
DB_CONNECTION_LIMIT=20

# ==================== JWT 认证 ====================
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=24h

# ==================== CORS（生产环境必填） ====================
CORS_ORIGIN=https://your-domain.com

# ==================== 账号管理 ====================
INIT_DEFAULT_PASSWORD=changeme123   # 新建用户默认初始密码（生产环境务必修改）
INIT_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# 高危开关，仅在明确重建整个数据库时临时改为 true，完成后立即恢复 false。
ALLOW_DATABASE_RESET=false

# ==================== 邮箱验证码 SMTP ====================
# 注册验证码和找回密码需要配置可发送邮件的邮箱服务。
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=综测管理平台 <no-reply@example.com>

# ==================== 文件上传 ====================
UPLOAD_MAX_SIZE=10485760
# 不配置时默认使用 public/uploads。生产环境建议放到代码目录外，并把该目录纳入备份。
UPLOAD_ROOT=/data/zongce/uploads

# ==================== 日志 ====================
LOG_LEVEL=info
